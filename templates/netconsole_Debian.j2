{{ '## netconsole' }}
{{ '# ' + ansible_managed }}
{{ '# Do not edit manually' }}

{% for n in lookup('ansible.builtin.vars',
  'linux_helper_netconsole_settings') %}
{% if (n['remote_ipaddr'] is defined and n['remote_ipaddr']
  not in ['', [], '[]', None]) and ((n['remote_ipaddr'] |
  ansible.utils.ipaddr('host')) is ansible.utils.ip()) %}
{% if n['remote_port'] is defined and n['remote_port']
  not in ['', [], '[]', None] %}
{{ 'NETCONSOLE_OPTS=' ~ n['remote_port'] ~ '@' + n['remote_ipaddr'] }}
{% endif %}
{% endif %}
{% endfor %}

