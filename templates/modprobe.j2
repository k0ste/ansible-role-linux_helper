{{ '## ' ~ lookup('ansible.builtin.vars', 'outer_item') ~ '.conf' }}
{{ '# ' + ansible_managed }}
{{ '# Do not edit manually' }}

{% for a in _linux_helper_modprobes_deploy['actions'] %}
{% if a['action'] is defined and a['action'] not in ['', [], '[]', None] %}
{% if a['action'] == 'alias' %}
{% if (a['wildcard'] is defined and
  a['wildcard'] not in ['', [], '[]', None]) and (a['module'] is defined and
  a['module'] not in ['', [], '[]', None]) %}
{{ 'alias ' ~ a['wildcard'] ~ ' ' ~ a['module'] }}
{% endif %}
{% elif a['action'] == 'blacklist' %}
{% if a['module'] is defined and a['module'] not in ['', [], '[]', None] %}
{{ 'blacklist ' ~ a['module'] }}
{% endif %}
{% elif a['action'] == 'options' %}
{% if (a['module'] is defined and a['module'] not in ['', [], '[]', None]) and (
  a['options'] is defined and a['options'] not in ['', [], '[]', None]) %}
{% if a['options'] is string %}
{{ 'options ' ~ a['module'] ~ ' ' ~ a['options'] }}
{% elif a['options'] is sequence %}
{{ 'options ' ~ a['module'] ~ ' ' ~ a['options'] | join(' ') }}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
